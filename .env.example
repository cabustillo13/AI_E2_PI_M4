# ───────────── Copiá este archivo a .env y completá. Nunca subas el .env al repo. ─────────────
# En Railway, estas mismas variables van en Settings → Variables de cada servicio.

# Dominio que atiende esta instancia: clinica | logistica | cobranzas
DOMAIN=clinica

# Clave que ElevenLabs usa para llamar a nuestro backend (Bearer). Generala con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
OPSVOICE_API_KEY=

# URL pública del servicio desplegado (la usa elevenlabs/sync_agent.py para configurar el Custom LLM)
PUBLIC_URL=https://opsvoice-clinica.up.railway.app

# ───────────── LLMs ─────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Cadena de fallback "proveedor:modelo" (en orden) y modelo barato al acercarse al presupuesto.
# El respaldo tiene que ser rápido y barato: en voz la latencia corta la conversación.
# Con un solo proveedor, el fallback puede ser otro modelo: LLM_CHAIN=openai:gpt-4.1-mini,openai:gpt-4o-mini
LLM_CHAIN=openai:gpt-4.1-mini,anthropic:claude-haiku-5-5
LLM_CHEAP=openai:gpt-4.1-nano
VISION_MODEL=openai:gpt-4.1-mini
VISION_FALLBACK=anthropic:claude-haiku-5-5

# ───────────── Harness ─────────────
FIRST_TOKEN_TIMEOUT_S=6
MAX_TOOL_ITERATIONS=5
RATE_LIMIT_PER_MINUTE=30
BUDGET_DEGRADE_RATIO=0.7

# ───────────── Observabilidad (Langfuse Cloud, plan gratuito) ─────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ───────────── ElevenLabs Agents ─────────────
ELEVENLABS_API_KEY=
# Lo completan los scripts de elevenlabs/ (también quedan en elevenlabs/agents/<dominio>.json)
ELEVENLABS_AGENT_ID=
